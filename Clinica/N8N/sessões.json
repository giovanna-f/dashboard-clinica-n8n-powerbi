      "parameters": {
        "language": "pythonNative",
        "pythonCode": "total_mensal = 0.0\n\nfor item in _items:\n    qtd = float(item[\"json\"][\"qtd\"])\n    valor = float(item[\"json\"][\"valor\"])\n    \n    total_mensal += qtd * valor\n\nreturn [\n    {\n        \"json\": {\n            \"total_mensal\": f\"{total_mensal:.2f}\"\n        }\n    }\n]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

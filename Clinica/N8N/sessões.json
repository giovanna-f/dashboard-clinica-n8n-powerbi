    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "total_qtd = 0.0\nvalor = 0.0\nnome = \"\"\n\nfor item in _items:\n    nome = item[\"json\"][\"nome\"]\n    total_qtd += float(item[\"json\"][\"qtd\"])\n    valor = float(item[\"json\"][\"valor\"])  # assume que é igual em todas\n\ntotal_final = total_qtd * valor\n\nreturn [\n    {\n        \"json\": {\n            \"nome\": nome,\n            \"qtd\": total_qtd,\n            \"valor\": valor,\n            \"total\": round(total_final, 2)\n        }\n    }\n]"
      },
